# Copy this file to .env (or .env.local) and fill in your own project values.
# Supabase: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Never put the service_role key in this file. The anon key is safe in the browser
# because every table is protected by row level security.
